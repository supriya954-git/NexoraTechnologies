@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Nexora Technologies</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f7fb;
            color: #333;
        }

        /* Header */
        header {
            background-color: #102a43;
            color: white;
            padding: 20px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo h1 {
            margin: 0;
            font-size: 28px;
        }

        .logo p {
            margin: 5px 0;
            color: #b9d6f2;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-size: 16px;
        }

        nav a:hover {
            color: #38bdf8;
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 50px;
            background-color: white;
        }

        .hero h2 {
            font-size: 36px;
            color: #102a43;
        }

        .hero p {
            font-size: 18px;
        }

        .hero img {
            width: 650px;
            max-width: 90%;
            margin-top: 20px;
            border-radius: 10px;
        }

        /* About Section */
        .about {
            padding: 40px 100px;
            text-align: center;
        }

        .about h2 {
            color: #102a43;
        }

       

        /* Footer */
        footer {
            background-color: #102a43;
            color:white;
            text-align: center;
            padding: 25px;
        }
    </style>
</head>

<body>


    <!-- Main Content -->

    <section class="hero">

        <h2>Welcome to Nexora Technologies</h2>

        <p>
            We build innovative digital solutions that help businesses
            grow, connect, and succeed.
        </p>

        <img src="~/Images/company.jpg"
     alt="Nexora Technologies"
     width="650">

    </section>


    <!-- About Company -->

    <section class="about">

        <h2>About Us</h2>

        <p>
            Nexora Technologies is a modern technology company focused
            on delivering reliable and innovative digital solutions.
            We combine creativity, technology, and expertise to solve
            real-world business challenges.
        </p>

        <p>
            Our team specializes in developing websites, software,
            mobile applications, cloud solutions, and customized
            business systems.
        </p>

    </section>

    <!-- Footer -->

    <footer>

        <h3>Nexora Technologies</h3>
        <p>Innovating Today. Empowering Tomorrow.</p>
        <p>Email: info@nexora.com | Phone: 9812345678</p>
        <p>&copy; 2026 Nexora Technologies. All Rights Reserved.</p>
    </footer>
</body>
</html>