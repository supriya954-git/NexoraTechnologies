@model List<NexoraTechnologies.Models.Event>

@{
    ViewData["Title"] = "Events";
}


<div class="events-container">

    <h1>Upcoming Events</h1>

    <p class="intro">
        Join Nexora Technologies and be part of our exciting upcoming events.
    </p>

    <div class="events-grid">

        @foreach (var item in Model)
        {
            <div class="event-card">

                <img src="@item.Image"
                     alt="@item.Name"
                     class="event-image">

                <div class="event-content">

                    <h2>@item.Name</h2>

                    <p class="event-date">
                        📅 @item.Date
                    </p>

                    <p class="event-location">
                        📍 @item.Location
                    </p>

                    <p class="event-description">
                        @item.Description
                    </p>

                    <a href="/Form" class="register-button">
                        Register Now
                    </a>

                </div>

            </div>
        }

    </div>

</div>

<style>

    .events-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 30px;
    }

        .events-container h1 {
            text-align: center;
            color: #102a43;
            font-size: 38px;
            margin-bottom: 10px;
        }

    .intro {
        text-align: center;
        color: #666;
        font-size: 18px;
        margin-bottom: 40px;
    }

    .events-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .event-card {
        background-color: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.12);
        transition: transform 0.3s;
    }

        .event-card:hover {
            transform: translateY(-5px);
        }

    .event-image {
        width: 100%;
        height: 230px;
        object-fit: cover;
    }

    .event-content {
        padding: 25px;
    }

        .event-content h2 {
            color: #102a43;
            margin-top: 0;
        }

    .event-date {
        color: #1d6fa5;
        font-weight: bold;
    }

    .event-location {
        color: #555;
        font-weight: bold;
    }

    .event-description {
        color: #555;
        line-height: 1.6;
    }

    .register-button {
        display: inline-block;
        margin-top: 15px;
        padding: 11px 20px;
        background-color: #102a43;
        color: white;
        text-decoration: none;
        border-radius: 6px;
    }

        .register-button:hover {
            background-color: #1d4e73;
        }

    @@media (max-width: 750px) {

        .events-grid {
            grid-template-columns: 1fr;
        }

        .events-container {
            padding: 15px;
        }
    }

</style>